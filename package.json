{
  "name": "@clickable/nuxt-img",
  "version": "0.1.2",
  "packageManager": "npm@10.9.3",
  "description": "Sharp-powered local image module for Nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisjoserivera/nuxt-sharp.git"
  },
  "homepage": "https://github.com/luisjoserivera/nuxt-sharp#readme",
  "bugs": {
    "url": "https://github.com/luisjoserivera/nuxt-sharp/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "images",
    "sharp",
    "responsive-images",
    "vue"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "check": "npm run lint && npm run test && npm run test:types",
    "prepublishOnly": "npm run check",
    "release": "npm run check && changelogen --release && npm publish --access public && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "link": "npm link",
    "unlink": "npm unlink"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "sharp": "^0.35.3",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "^22.19.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.9.1",
    "nuxt": "^4.5.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "eslint-plugin-regexp": "3.1.1"
  }
}
